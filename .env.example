# PostgreSQL connection used by Prisma and the Next.js app.
# Matches the credentials in docker-compose.yml. When unset, the app and the
# Prisma CLI fall back to this exact value, so copying this file is optional.
DATABASE_URL="postgresql://atm:atm@localhost:5432/atm_simulator"

# Database used by the integration tests. The test setup creates it on demand.
TEST_DATABASE_URL="postgresql://atm:atm@localhost:5432/atm_simulator_test"
